<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <!-- ================================================================
         web.xml - 서블릿 배포 서술자
         Jakarta EE 10 / Tomcat 10.x 기준 (jakarta.* 네임스페이스 사용)
         ================================================================ -->

    <display-name>springdemoweb4</display-name>


    <!-- ======================== Root ApplicationContext 설정 ======================== -->
    <!-- Spring Root 컨테이너 설정 파일 위치 (서비스, 리포지토리, DB 관련 빈) -->
    <context-param>
        <param-name>contextConfigLocation</param-name>
        <param-value>classpath:applicationContext.xml</param-value>
    </context-param>

    <!-- ContextLoaderListener: 웹 애플리케이션 시작 시 Root ApplicationContext 생성 -->
    <listener>
        <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
    </listener>


    <!-- ======================== 한글 인코딩 필터 ======================== -->
    <!-- POST 요청의 한글 파라미터 깨짐 방지 (GET은 Tomcat server.xml URIEncoding으로 처리) -->
    <filter>
        <filter-name>characterEncodingFilter</filter-name>
        <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
        <init-param>
            <!-- 인코딩 방식: UTF-8 -->
            <param-name>encoding</param-name>
            <param-value>UTF-8</param-value>
        </init-param>
        <init-param>
            <!-- 이미 인코딩이 설정되어 있어도 강제로 UTF-8 적용 -->
            <param-name>forceEncoding</param-name>
            <param-value>true</param-value>
        </init-param>
    </filter>

    <!-- 모든 요청(/*) 에 인코딩 필터 적용 -->
    <filter-mapping>
        <filter-name>characterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>


    <!-- ======================== DispatcherServlet (Front Controller) ======================== -->
    <!-- Spring MVC의 핵심 서블릿: 모든 HTTP 요청을 받아 컨트롤러로 위임 -->
    <servlet>
        <servlet-name>dispatcherServlet</servlet-name>
        <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
        <init-param>
            <!-- Spring MVC 설정 파일 위치 (컨트롤러, ViewResolver 등 웹 계층 빈) -->
            <param-name>contextConfigLocation</param-name>
            <param-value>/WEB-INF/spring-mvc.xml</param-value>
        </init-param>
        <!-- 서버 시작 시 즉시 초기화 (값이 낮을수록 먼저 로드) -->
        <load-on-startup>1</load-on-startup>
        <multipart-config>
	        <!-- 업로드 임시 저장 디렉토리 (비어 있으면 시스템 기본 경로 사용) -->
	        <location></location>
	        <!-- 파일 하나의 최대 크기: 10MB -->
	        <max-file-size>10485760</max-file-size>
	        <!-- 요청 전체의 최대 크기: 50MB -->
        	<max-request-size>52428800</max-request-size>
    </multipart-config>
    </servlet>

    <!-- DispatcherServlet이 처리할 URL 패턴: / (정적 리소스 제외 전체) -->
    <servlet-mapping>
        <servlet-name>dispatcherServlet</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

</web-app>
